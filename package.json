{
  "name": "wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts",
    "start:api": "APP_ROLE=api bun run src/main.ts",
    "start:worker": "APP_ROLE=worker bun run src/main.ts",
    "migration:up": "bun run src/infra/database/migrate.ts up",
    "migration:down": "bun run src/infra/database/migrate.ts down",
    "typecheck": "tsc --noEmit",
    "test": "bun test test/unit",
    "test:integration": "bun test test/integration --timeout 60000",
    "test:concurrency": "bun test test/concurrency --timeout 120000",
    "test:all": "bun run test && bun run test:integration && bun run test:concurrency",
    "test:load": "bun run test/load/load.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1152.0",
    "@mikro-orm/core": "^6.6",
    "@mikro-orm/migrations": "^6.6",
    "@mikro-orm/nestjs": "^6.1",
    "@mikro-orm/postgresql": "^6.6",
    "@nestjs/common": "^11",
    "@nestjs/core": "^11",
    "@nestjs/platform-express": "^11",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "typescript": "^5.9"
  }
}
